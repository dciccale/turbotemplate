{
  "name": "@turbotemplate/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Convex backend",
  "main": "convex/_generated/api.js",
  "types": "convex/_generated/api.d.ts",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./convex": {
      "types": "./convex/_generated/server.d.ts",
      "default": "./convex/_generated/server.js"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "lint": "biome lint",
    "format": "biome check --write",
    "build": "echo 'Build step skipped - Convex API files should be pre-generated'",
    "deploy": "convex deploy",
    "check-types": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.60",
    "@convex-dev/resend": "^0.2.8",
    "@convex-dev/stripe": "^0.1.6",
    "@turbotemplate/emails": "workspace:*",
    "@types/node": "^26.4.1",
    "ai": "^7.0.93",
    "convex": "^1.45.0",
    "stripe": "^22.6.1",
    "zod": "^4.5.4",
    "@turbotemplate/i18n": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "vitest": "^5.0.0",
    "convex-test": "^0.0.56",
    "@edge-runtime/vm": "^5.0.0",
    "typescript": "^7.0.2"
  }
}
