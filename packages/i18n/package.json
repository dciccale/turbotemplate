{
  "name": "@turbotemplate/i18n",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./email": "./src/email.ts",
    "./messages/*.json": "./src/messages/*.json",
    "./browser": "./src/browser.ts",
    "./clerk": "./src/clerk.ts",
    "./messages": "./src/messages.ts"
  },
  "scripts": {
    "test": "vitest run",
    "check-i18n": "bun src/check.ts",
    "check-types": "tsc --noEmit",
    "check-template": "bun src/check-template.ts",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "dependencies": {
    "negotiator": "^1.1.0",
    "intl-messageformat": "^12.1.4",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@clerk/localizations": "^4.24.5"
  },
  "devDependencies": {
    "@types/negotiator": "^0.6.5",
    "vitest": "^5.1.0",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6",
    "@babel/parser": "^8.1.0",
    "@biomejs/biome": "2.6.5"
  },
  "bin": {
    "check-ui-copy": "./src/scan.ts"
  }
}
