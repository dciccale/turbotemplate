{
  "name": "turbotemplate",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "check-i18n": "turbo run check-i18n",
    "check-template": "turbo run check-template"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "next@16.3.4": "patches/next@16.3.4.patch"
  }
}
