{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "APP_ORIGIN",
        "CLERK_SECRET_KEY",
        "EMAIL_DELIVERY_PROVIDER",
        "PLUNK_API_KEY",
        "PLUNK_FROM_EMAIL",
        "PLUNK_TEST_MODE",
        "PLUNK_WEBHOOK_SECRET",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "RESEND_TEST_MODE"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "APP_ORIGIN",
        "CLERK_SECRET_KEY",
        "CLERK_WEBHOOK_SECRET",
        "CLERK_JWT_ISSUER_DOMAIN",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_MARKETING_URL",
        "EMAIL_DELIVERY_PROVIDER",
        "PLUNK_API_KEY",
        "PLUNK_FROM_EMAIL",
        "PLUNK_TEST_MODE",
        "PLUNK_WEBHOOK_SECRET",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "RESEND_TEST_MODE"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "check-i18n": {
      "dependsOn": [
        "^check-i18n"
      ]
    },
    "check-template": {
      "cache": false
    },
    "@turbotemplate/backend#build": {
      "outputs": []
    }
  }
}
